      <aliases enabled='yes' />
      <column caption='Avg Engagement Rate %' datatype='real' name='[Calculation_0230947428167683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Engagement]) / SUM([Views])' />
      </column>
      <column caption='Avg CTR %' datatype='real' name='[Calculation_0230947428319236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Clicks]) / SUM([Impressions])' />
      </column>
      <column caption='Amplification Rate %' datatype='real' name='[Calculation_0230947428409349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Shares]) / SUM([Views])' />
      </column>
      <column caption='Total Posts' datatype='integer' name='[Calculation_0230947428450310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Post_ID])' />
      </column>
      <column caption='High ER Ratio' datatype='real' name='[Calculation_0230947428515847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Engagement_Level] = &apos;High&apos; THEN 1 ELSE 0 END) / COUNT([Post_ID])' />
      </column>
